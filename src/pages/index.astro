---
import BaseLayout from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const workItems = await getCollection('work');
workItems.sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL;
const heroPoster = `${base}assets/hero-poster.jpg`;
const heroWebm = `${base}assets/hero-loop.webm`;
const heroMp4 = `${base}assets/hero-loop.mp4`;
const codequestRoute = `${base}work/codequest/`;
const aksaranetraRoute = `${base}work/aksaranetra/`;
const ukmcodingRoute = `${base}work/ukm-coding/`;
const andalasiaRoute = `${base}work/andalasia/`;
---

<BaseLayout
  title="Rafi Fernanda · Full-stack Developer"
  description="Full-stack developer building reliable web applications, APIs, and real-time dashboards with TypeScript, Next.js, and PostgreSQL. Open for freelance projects and internships."
  showLoader={true}
  showRail={true}
>
  <main id="top">

  <!-- ============ 01 HERO ============ -->
  <section class="hero">
    <div class="hero__inner">
      <p class="hero__eyebrow mono" data-fade>Full-stack Engineer &amp; Systems Builder</p>

      <div class="hero__mask" data-hero-mask>
        <video class="hero__video-source" data-hero-video autoplay muted loop playsinline preload="auto" poster={heroPoster} aria-hidden="true">
          <source src={heroWebm} type="video/webm">
          <source src={heroMp4} type="video/mp4">
        </video>
        <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
        <h1 class="hero__title" data-hero-title>
          <span class="hero__line"><span>I build web products</span></span>
          <span class="hero__line"><span>from first schema</span></span>
          <span class="hero__line"><span>to production launch</span></span>
        </h1>
      </div>

      <div class="hero__foot">
        <p class="hero__lede" data-fade>I build full-stack web applications, dashboards, and backend APIs from scratch to production. Available for freelance contracts and engineering roles.</p>
        <div class="hero__actions" data-fade>
          <a class="btn btn--solid" href="#work" data-magnetic><span>Selected work</span></a>
          <a class="btn" href="#contact" data-magnetic><span>Discuss a project</span><span><span class="arw">&#8599;</span></span></a>
        </div>
      </div>
    </div>
    <div class="hero__meta mono" data-fade>
      <span>Available for work</span>
      <span>Based in Jakarta</span>
      <span class="hero__scroll">Scroll to explore <i></i></span>
    </div>
  </section>

  <!-- ============ 02 MARQUEE ============ -->
  <section class="marquee" data-marquee aria-hidden="true">
    <div class="marquee__track" data-marquee-track>
      <span>Full-stack web apps</span><i>|</i>
      <span>SaaS MVPs</span><i>|</i>
      <span>Custom dashboards</span><i>|</i>
      <span>Database design</span><i>|</i>
      <span>Backend APIs</span><i>|</i>
      <span>Marketing websites</span><i>|</i>
      <span>Production deploy</span><i>|</i>
    </div>
  </section>

  <!-- ============ 03 STATEMENT ============ -->
  <section class="statement" data-skew>
    <span class="statement__mark mono" data-fade>Engineering standard</span>
    <p class="statement__text" data-split>Great software feels effortless because <em>the engineering behind it was intentional from day one</em></p>
  </section>

  <!-- ============ 04 HOW I WORK ============ -->
  <section class="how" data-skew>
    <p class="section__note mono" data-fade style="text-align:left;padding:0 0 clamp(20px,3vh,34px)">How I work</p>
    <ul class="how__list">
      <li class="how__item" data-fade>
        <span class="how__num">01</span>
        <h3 class="how__title">Align on architecture before writing a single line of code</h3>
        <p class="how__body">We define your product requirements, user flows, and technical constraints upfront. You get honest recommendations on the simplest stack that fits your budget and timeline, avoiding expensive rework later.</p>
      </li>
      <li class="how__item" data-fade style="--d:80ms">
        <span class="how__num">02</span>
        <h3 class="how__title">Weekly staging builds &amp; zero black-box periods</h3>
        <p class="how__body">You get an active preview URL every week to test on your phone and laptop. You see real progress in real time, and we adjust details together while the code is fresh.</p>
      </li>
      <li class="how__item" data-fade style="--d:160ms">
        <span class="how__num">03</span>
        <h3 class="how__title">Clean handover with zero vendor lock-in</h3>
        <p class="how__body">When we launch, you own everything. You receive a clean repository, documented deployment guides, and tested code that runs reliably so your team can maintain or scale it without needing to rely on me forever.</p>
      </li>
    </ul>
  </section>

  <!-- ============ 05 WORK ============ -->
  <section class="work" id="work">
    <div class="work__head">
      <div class="section__head">
        <span class="section__num mono">01</span>
        <h2 class="section__title" data-split>Selected work</h2>
        <p class="section__note mono" data-fade>Four selected projects · 2023 to 2026</p>
      </div>
    </div>

    <div class="work__pin" data-work-pin>
      <div class="work__track" data-work-track>

        <!-- Panel 1: CodeQuest -->
        <article class="panel">
          <a class="panel__media" href={codequestRoute} data-pt data-hover="View case">
            <span class="panel__badge mono">Case study</span>
            <img src={`${base}assets/work-codequest.png`} alt="CodeQuest interface">
          </a>
          <div class="panel__body">
            <span class="panel__index mono">01 / Full-stack platform</span>
            <h3 class="panel__title">CodeQuest</h3>
            <p class="panel__desc">Gamified learning platform built for Cyber University's coding club. Handles structured programming tracks, code submissions, real-time progress tracking, and role-based student access.</p>
            <ul class="panel__facts">
              <li><span class="mono">Role</span>Solo developer</li>
              <li><span class="mono">Year</span>2026</li>
              <li><span class="mono">Stack</span>Next.js · Prisma · Supabase · NextAuth · Tailwind</li>
            </ul>
            <div class="panel__links">
              <a class="link" href={codequestRoute} data-pt data-magnetic>Read the case study <span><span class="arw">&#8599;</span></span></a>
              <a class="link link--dim" href="https://github.com/Randevough/CodeQuest" target="_blank" rel="noopener" data-magnetic>Source code <span><span class="arw">&#8599;</span></span></a>
            </div>
          </div>
        </article>

        <!-- Panel 2: AksaraNetra -->
        <article class="panel">
          <a class="panel__media" href={aksaranetraRoute} data-pt data-hover="View case">
            <span class="panel__badge mono">Case study</span>
            <img src={`${base}assets/work-aksaranetra.png`} alt="AksaraNetra accessibility audit platform">
          </a>
          <div class="panel__body">
            <span class="panel__index mono">02 / Accessibility engine</span>
            <h3 class="panel__title">AksaraNetra</h3>
            <p class="panel__desc">Automated web accessibility audit engine. Runs headless Chromium on a VPS to scan live pages, detect WCAG contrast and ARIA defects, and stream diagnostic scores to a Next.js dashboard.</p>
            <ul class="panel__facts">
              <li><span class="mono">Role</span>Full-stack engineer</li>
              <li><span class="mono">Year</span>2025</li>
              <li><span class="mono">Stack</span>Next.js · Node.js · TypeScript · Playwright · Chromium</li>
            </ul>
            <div class="panel__links">
              <a class="link" href={aksaranetraRoute} data-pt data-magnetic>Read the case study <span><span class="arw">&#8599;</span></span></a>
              <a class="link link--dim" href="https://aksaranetra.vercel.app/" target="_blank" rel="noopener" data-magnetic>Live demo <span><span class="arw">&#8599;</span></span></a>
            </div>
          </div>
        </article>

        <!-- Panel 3: UKM Coding -->
        <article class="panel">
          <a class="panel__media" href={ukmcodingRoute} data-pt data-hover="View case">
            <span class="panel__badge mono">Case study</span>
            <img src={`${base}assets/work-ukmcoding.png`} alt="UKM Coding community platform">
          </a>
          <div class="panel__body">
            <span class="panel__index mono">03 / Editorial &amp; Community</span>
            <h3 class="panel__title">UKM Coding</h3>
            <p class="panel__desc">Official editorial website and project archive for Cyber University's coding community. Connects an Astro frontend with Sanity Studio CMS so student writers can draft articles and showcase software projects independently.</p>
            <ul class="panel__facts">
              <li><span class="mono">Role</span>Tech lead &amp; developer</li>
              <li><span class="mono">Year</span>2025</li>
              <li><span class="mono">Stack</span>Astro · React · TypeScript · Sanity CMS · CSS</li>
            </ul>
            <div class="panel__links">
              <a class="link" href={ukmcodingRoute} data-pt data-magnetic>Read the case study <span><span class="arw">&#8599;</span></span></a>
              <a class="link link--dim" href="https://ukmcoding.site/" target="_blank" rel="noopener" data-magnetic>Live demo <span><span class="arw">&#8599;</span></span></a>
            </div>
          </div>
        </article>

        <!-- Panel 4: Andalasia Creative -->
        <article class="panel">
          <a class="panel__media" href={andalasiaRoute} data-pt data-hover="View case">
            <span class="panel__badge mono">Case study</span>
            <img src={`${base}assets/work-andalasia.png`} alt="Andalasia Creative production website">
          </a>
          <div class="panel__body">
            <span class="panel__index mono">04 / Client agency site</span>
            <h3 class="panel__title">Andalasia Creative</h3>
            <p class="panel__desc">Commercial website for a creative production house and event management agency. Features interactive portfolio showcases, event service catalogs, and clear inquiry funnels optimized for mobile clients.</p>
            <ul class="panel__facts">
              <li><span class="mono">Role</span>Frontend developer</li>
              <li><span class="mono">Year</span>2024</li>
              <li><span class="mono">Stack</span>React · Vite · Tailwind CSS · JavaScript</li>
            </ul>
            <div class="panel__links">
              <a class="link" href={andalasiaRoute} data-pt data-magnetic>Read the case study <span><span class="arw">&#8599;</span></span></a>
              <a class="link link--dim" href="https://andalasiagroup.com/" target="_blank" rel="noopener" data-magnetic>Live demo <span><span class="arw">&#8599;</span></span></a>
            </div>
          </div>
        </article>

      </div>

    <div class="work__rail">
      <span class="work__hint mono">Scroll</span>
      <div class="work__bar"><i data-work-bar></i></div>
      <span class="work__hint mono" data-work-count>01 / 04</span>
    </div>
    </div>
  </section>

  <!-- ============ 06 SERVICES ============ -->
  <section class="section services" id="services" data-skew>
    <div class="section__head">
      <span class="section__num mono">02</span>
      <h2 class="section__title" data-split>What I can build for you</h2>
      <p class="section__note mono" data-fade>Clear scope, weekly milestones, and documented deliverables.</p>
    </div>

    <div class="svc">
      <div class="svc__card" data-fade>
        <span class="svc__num mono">S01</span>
        <h3>Web application</h3>
        <p>End-to-end web application development from database architecture to production deployment, built with type safety, authentication, and an operational admin dashboard.</p>
        <ul>
          <li>Full-stack Next.js or React application</li>
          <li>PostgreSQL schema design and authentication</li>
          <li>Admin management dashboard</li>
          <li>CI/CD deployment pipeline and handover documentation</li>
        </ul>
        <span class="svc__meta mono">3&ndash;6 weeks</span>
      </div>
      <div class="svc__card" data-fade>
        <span class="svc__num mono">S02</span>
        <h3>Marketing site</h3>
        <p>High-performance marketing websites optimized for search engines and conversion, connected to an intuitive CMS so your team can publish updates independently.</p>
        <ul>
          <li>Responsive UI design and frontend build</li>
          <li>Headless CMS integration for easy content edits</li>
          <li>Technical SEO, OpenGraph cards, and analytics setup</li>
          <li>Sub-second load times with 90+ Lighthouse performance scores</li>
        </ul>
        <span class="svc__meta mono">1&ndash;2 weeks</span>
      </div>
      <div class="svc__card" data-fade>
        <span class="svc__num mono">S03</span>
        <h3>IoT &amp; dashboards</h3>
        <p>Connected IoT devices paired with secure data pipelines and responsive web dashboards for real-time sensor monitoring and device control.</p>
        <ul>
          <li>ESP32 or Arduino C++ firmware development</li>
          <li>MQTT or HTTP telemetry ingestion and storage</li>
          <li>Real-time browser monitoring dashboard</li>
          <li>Hardware wiring schematics and operational documentation</li>
        </ul>
        <span class="svc__meta mono">2&ndash;4 weeks</span>
      </div>
    </div>

    <ol class="process" data-fade>
      <li><span class="mono">01</span><strong>Discovery</strong>We outline core product requirements, user flows, and technical constraints.</li>
      <li><span class="mono">02</span><strong>Scope</strong>A clear written agreement detailing exact deliverables, fixed pricing, and project milestones.</li>
      <li><span class="mono">03</span><strong>Build</strong>Weekly development sprints with interactive preview links for continuous feedback.</li>
      <li><span class="mono">04</span><strong>Handover</strong>Live production deployment, clean repository access, and step-by-step setup guides.</li>
    </ol>
  </section>

  <!-- ============ 07 ABOUT ============ -->
  <section class="section about" id="about" data-skew>
    <div class="section__head">
      <span class="section__num mono">03</span>
      <h2 class="section__title" data-split>About</h2>
    </div>
    <div class="about__grid">
      <p class="about__lead" data-fade>I started in network infrastructure before moving into full-stack software development.</p>
      <div class="about__body">
        <p data-fade>My technical background began in network engineering during an internship at PUSHANSIBER (Kemhan RI). Configuring routers, monitoring traffic, and resolving connectivity faults taught me to isolate root causes systematically instead of guessing.</p>
        <p data-fade>Today, I study Informatics at Cyber University and lead the campus coding club (UKM Coding). I guide over 50 members through structured workshops, code reviews, and collaborative team builds using TypeScript, React, Next.js, and PostgreSQL.</p>
        <p data-fade>Across web applications and IoT systems, I prioritize clean database architecture, comprehensive error states, and responsive performance on real mobile networks.</p>
      </div>
    </div>
  </section>

  <!-- ============ 08 EXPERIENCE ============ -->
  <section class="section exp" id="experience" data-skew>
    <div class="section__head">
      <span class="section__num mono">04</span>
      <h2 class="section__title" data-split>Experience</h2>
      <p class="section__note mono" data-fade>Hover a row for detail</p>
    </div>
    <div class="rows" data-rows></div>
  </section>

  <!-- ============ 09 STACK ============ -->
  <section class="section stack" id="stack">
    <div class="section__head">
      <span class="section__num mono">05</span>
      <h2 class="section__title" data-split>Stack</h2>
      <p class="section__note mono" data-fade>Hover a tool to view projects built with it</p>
    </div>
    <div class="stack__wrap">
      <div class="stack__list" data-stack></div>
      <aside class="stack__proof">
        <h3>Evidence</h3>
        <ul class="proof" data-proof></ul>
        <p class="stack__hint" data-stack-hint>All tools</p>
      </aside>
    </div>
  </section>

  <!-- ============ 10 CONTACT ============ -->
  <section class="section contact" id="contact" data-skew>
    <div class="contact__top">
      <span class="section__num mono">06</span>
      <h2 class="contact__title" data-contact-title>
        <span class="hero__line"><span>Let's build</span></span>
        <span class="hero__line"><span>something solid.</span></span>
      </h2>
    </div>
    <div class="contact__grid">
      <div class="contact__left">
        <a class="contact__mail" href="mailto:randdevs54@gmail.com" data-magnetic>randdevs54@gmail.com</a>
        <p class="contact__note" data-fade>Tell me about your project scope and target launch date. I reply within 24 hours.</p>
        <div class="contact__socials">
          <a href="https://github.com/randevough" target="_blank" rel="noopener">GitHub <span><span class="arw">&#8599;</span></span></a>
          <a href="https://www.linkedin.com/in/muhamad-rafi-fernanda-5248a0301/" target="_blank" rel="noopener">LinkedIn <span><span class="arw">&#8599;</span></span></a>
          <a href="https://wa.me/62XXXXXXXXXX" target="_blank" rel="noopener">WhatsApp <span><span class="arw">&#8599;</span></span></a>
          <a href="https://instagram.com/randevough" target="_blank" rel="noopener">Instagram <span><span class="arw">&#8599;</span></span></a>
        </div>
      </div>

      <form class="cform" data-cform action="https://api.web3forms.com/submit" method="POST" novalidate>
        <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY">
        <input type="checkbox" name="botcheck" class="cform__hp" tabindex="-1" autocomplete="off" aria-hidden="true">

        <div class="field" data-field>
          <input id="f-name" name="name" type="text" placeholder=" " required autocomplete="name">
          <label for="f-name">Name</label>
          <span class="field__line"></span>
          <span class="field__err">Required</span>
        </div>

        <div class="field" data-field>
          <input id="f-mail" name="email" type="email" placeholder=" " required autocomplete="email">
          <label for="f-mail">Email</label>
          <span class="field__line"></span>
          <span class="field__err">Check the address</span>
        </div>

        <div class="field" data-field>
          <textarea id="f-msg" name="message" rows="4" placeholder=" " required maxlength="600" data-counter></textarea>
          <label for="f-msg">What are you building?</label>
          <span class="field__line"></span>
          <span class="field__count" data-count>0 / 600</span>
        </div>

        <div class="cform__foot">
          <button class="send" type="submit" data-send data-magnetic>
            <span data-send-label>Send message</span><i></i>
          </button>
          <p class="cform__status mono" data-cform-status role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>

  </main>
</BaseLayout>
