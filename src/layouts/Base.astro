---
import TextureLayers from '../components/TextureLayers.astro';
import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionRail from '../components/SectionRail.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  showLoader?: boolean;
  isCaseStudy?: boolean;
  showRail?: boolean;
  preloadImage?: string;
  preloadVideo?: string;
  ogImage?: string;
}

const {
  title,
  description,
  showLoader = false,
  isCaseStudy = false,
  showRail = false,
  preloadImage,
  preloadVideo,
  ogImage,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://rafifernanda.site';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://rafifernanda.site');
const socialImageURL = new URL(ogImage || 'assets/hero-poster.jpg', Astro.site || 'https://rafifernanda.site');

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      'url': siteUrl,
      'name': 'Muhamad Rafi Fernanda | Portfolio',
      'description': 'Full-stack developer building web applications, APIs, and dashboards.',
      'publisher': {
        '@id': `${siteUrl}/#person`
      },
      'inLanguage': 'en-US'
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      'name': 'Muhamad Rafi Fernanda',
      'givenName': 'Muhamad Rafi',
      'familyName': 'Fernanda',
      'alternateName': ['Rafi Fernanda', 'Randevough'],
      'url': siteUrl,
      'image': `${siteUrl}/assets/hero-poster.jpg`,
      'jobTitle': 'Full-stack Developer',
      'sameAs': [
        'https://github.com/randevough',
        'https://www.linkedin.com/in/muhamad-rafi-fernanda-5248a0301/',
        'https://instagram.com/randevough'
      ],
      'alumniOf': {
        '@type': 'CollegeOrUniversity',
        'name': 'Cyber University'
      },
      'knowsAbout': [
        'Full-stack Development',
        'TypeScript',
        'React',
        'Next.js',
        'Astro',
        'PostgreSQL',
        'Node.js',
        'API Architecture'
      ]
    },
    ...(isCaseStudy
      ? [
          {
            '@type': 'TechArticle',
            '@id': `${canonicalURL.toString()}#article`,
            'url': canonicalURL.toString(),
            'headline': title,
            'description': description,
            'image': socialImageURL.toString(),
            'author': {
              '@id': `${siteUrl}/#person`
            },
            'publisher': {
              '@id': `${siteUrl}/#person`
            },
            'mainEntityOfPage': canonicalURL.toString(),
            'inLanguage': 'en-US'
          },
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonicalURL.toString()}#breadcrumb`,
            'itemListElement': [
              {
                '@type': 'ListItem',
                'position': 1,
                'name': 'Home',
                'item': `${siteUrl}/`
              },
              {
                '@type': 'ListItem',
                'position': 2,
                'name': 'Work',
                'item': `${siteUrl}/#work`
              },
              {
                '@type': 'ListItem',
                'position': 3,
                'name': title.split('—')[0].trim(),
                'item': canonicalURL.toString()
              }
            ]
          }
        ]
      : [])
  ]
};
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalURL}>
<meta name="robots" content="index, follow">
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
<meta name="author" content="Muhamad Rafi Fernanda">
<meta name="keywords" content="Muhamad Rafi Fernanda, Rafi Fernanda, Randevough, Full-stack Developer, Software Engineer, Web Developer Jakarta, TypeScript, Next.js, PostgreSQL">
<meta name="theme-color" content="#121211">
<meta name="google-site-verification" content="ws6bbgVD92MH1Oy8r5Tt9U_n7PkneGLB2aq3X3GW6As">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta http-equiv="X-Content-Type-Options" content="nosniff">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: blob:; media-src 'self' data: blob:; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; object-src 'none'; base-uri 'self'; upgrade-insecure-requests;">

<!-- Open Graph / Facebook -->
<meta property="og:type" content={isCaseStudy ? 'article' : 'profile'}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={socialImageURL}>
<meta property="og:site_name" content="Muhamad Rafi Fernanda">
<meta property="og:locale" content="en_US">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:url" content={canonicalURL}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={socialImageURL}>

<!-- Favicon & Touch Icons -->
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="shortcut icon" href="/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<meta name="apple-mobile-web-app-title" content="Rafi Fernanda">
<link rel="manifest" href="/site.webmanifest">

<!-- Structured Data -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />

{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high">}
{preloadVideo && <link rel="preload" as="video" href={preloadVideo} type="video/webm">}
<link rel="preload" href="/fonts/inter-tight-7-NGSwv5HMAFg6IuGlBNMjxLsH8ag.woff2" as="font" type="font/woff2" crossorigin>
<script is:inline>
(function(){var d=document.documentElement,c=[];
try{
  if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches)c.push('motion');
  if(window.matchMedia('(hover:hover) and (pointer:fine)').matches)c.push('fine');
}catch(e){}
if(c.length)d.className=(d.className+' '+c.join(' ')).trim();})();
</script>
</head>
<body>

<div class="pt" data-pt-curtain aria-hidden="true"><span class="pt__mark">Muhamad Rafi Fernanda</span></div>
<TextureLayers />

{showLoader && <Loader />}
<div class="cursor" data-cursor aria-hidden="true"><span class="cursor__label" data-cursor-label></span></div>

<Nav isCaseStudy={isCaseStudy} />

<slot />

{showRail && <SectionRail />}
{!isCaseStudy && <div class="footspacer" data-footspacer></div>}

<Footer lean={isCaseStudy} />

<script src="../scripts/main.ts"></script>
</body>
</html>
