---
import TextureLayers from '../components/TextureLayers.astro';
import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionRail from '../components/SectionRail.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  showLoader?: boolean;
  isCaseStudy?: boolean;
  showRail?: boolean;
  preloadImage?: string;
  ogImage?: string;
}

const {
  title,
  description,
  showLoader = false,
  isCaseStudy = false,
  showRail = false,
  preloadImage,
  ogImage,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://rafifernanda.site';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://rafifernanda.site');
const socialImageURL = new URL(ogImage || 'assets/hero-poster.jpg', Astro.site || 'https://rafifernanda.site');

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      'url': siteUrl,
      'name': 'Rafi Fernanda · Portfolio',
      'description': 'Full-stack developer building web applications, APIs, and dashboards.',
      'publisher': {
        '@id': `${siteUrl}/#person`
      },
      'inLanguage': 'en-US'
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      'name': 'Rafi Fernanda',
      'alternateName': ['Muhamad Rafi Fernanda', 'Randevough'],
      'url': siteUrl,
      'image': `${siteUrl}/assets/hero-poster.jpg`,
      'jobTitle': 'Full-stack Developer',
      'sameAs': [
        'https://github.com/randevough',
        'https://www.linkedin.com/in/muhamad-rafi-fernanda-5248a0301/',
        'https://instagram.com/randevough'
      ],
      'knowsAbout': [
        'Full-stack Development',
        'TypeScript',
        'React',
        'Next.js',
        'Astro',
        'PostgreSQL',
        'Node.js',
        'API Architecture'
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalURL}>
<meta name="robots" content="index, follow">
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
<meta name="author" content="Muhamad Rafi Fernanda">
<meta name="keywords" content="Rafi Fernanda, Muhamad Rafi Fernanda, Randevough, Full-stack Developer, Software Engineer, Web Developer Jakarta, TypeScript, Next.js, PostgreSQL">
<meta name="theme-color" content="#121211">

<!-- Open Graph / Facebook -->
<meta property="og:type" content={isCaseStudy ? 'article' : 'profile'}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={socialImageURL}>
<meta property="og:site_name" content="Rafi Fernanda">
<meta property="og:locale" content="en_US">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:url" content={canonicalURL}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={socialImageURL}>

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<!-- Structured Data -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />

{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high">}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap">
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.setAttribute('media', 'all')">
<noscript>
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</noscript>
<script is:inline>
(function(){var d=document.documentElement,c=[];
try{
  if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches)c.push('motion');
  if(window.matchMedia('(hover:hover) and (pointer:fine)').matches)c.push('fine');
}catch(e){}
if(c.length)d.className=(d.className+' '+c.join(' ')).trim();})();
</script>
</head>
<body>

<div class="pt" data-pt-curtain aria-hidden="true"><span class="pt__mark">Rafi Fernanda</span></div>
<TextureLayers />

{showLoader && <Loader />}
<div class="cursor" data-cursor aria-hidden="true"><span class="cursor__label" data-cursor-label></span></div>

<Nav isCaseStudy={isCaseStudy} />

<slot />

{showRail && <SectionRail />}
{!isCaseStudy && <div class="footspacer" data-footspacer></div>}

<Footer lean={isCaseStudy} />

<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js"></script>
<script src="../scripts/main.ts"></script>
</body>
</html>
