---
interface Props {
  isCaseStudy?: boolean;
}

const { isCaseStudy = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const cvPath = `${base}assets/CV_Muhamad%20Rafi%20Fernanda.pdf`;
const navClass = isCaseStudy ? "nav is-solid" : "nav";
const indexPrefix = isCaseStudy ? base : "";
---

<header class={navClass} data-nav>
  <div class="nav__inner">
    {isCaseStudy ? (
      <a class="nav__mark" href={base} data-pt>Rafi Fernanda</a>
    ) : (
      <a class="nav__mark" href="#top">Rafi Fernanda</a>
    )}
    <nav class="nav__links">
      <a href={`${indexPrefix}#work`}>Work</a>
      <a href={`${indexPrefix}#services`}>Services</a>
      <a href={`${indexPrefix}#about`}>About</a>
      <a href={`${indexPrefix}#experience`}>Experience</a>
      {!isCaseStudy && <a href="#contact">Contact</a>}
    </nav>
    <div class="nav__right">
      {isCaseStudy ? (
        <a class="btn" href={`${base}#contact`} data-magnetic><span>Contact</span></a>
      ) : (
        <a class="btn" href={cvPath} data-magnetic><span>Resume</span><span><img class="arw" src={`${base}arrow.svg`} alt="" aria-hidden="true" /></span></a>
      )}
    </div>
    {!isCaseStudy && (
      <button class="nav__burger" data-burger aria-label="Menu" aria-expanded="false"><span></span><span></span></button>
    )}
  </div>
</header>

{!isCaseStudy && (
  <div class="navmenu" data-navmenu>
    <a href="#work"><span>01</span>Work</a>
    <a href="#services"><span>02</span>Services</a>
    <a href="#about"><span>03</span>About</a>
    <a href="#experience"><span>04</span>Experience</a>
    <a href="#contact"><span>05</span>Contact</a>
    <div class="navmenu__foot">
      <a href="https://mail.google.com/mail/?view=cm&fs=1&to=muhamadrafifernanda@gmail.com&su=Project%20Inquiry%20%7C%20Rafi%20Fernanda&body=Hi%20Rafi%2C%0A%0AI%20would%20like%20to%20discuss%20a%20project%20with%20you%3A%0A-%20Project%20Overview%3A%20%0A-%20Target%20Timeline%3A%20%0A-%20Estimated%20Budget%3A%20%0A%0ABest%20regards%2C" target="_blank" rel="noopener noreferrer">muhamadrafifernanda@gmail.com</a>
      <a href={cvPath}>Resume <img class="arw" src={`${base}arrow.svg`} alt="" aria-hidden="true" /></a>
    </div>
  </div>
)}
