---
interface Props {
  lean?: boolean;
}

const { lean = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const cvPath = `${base}assets/CV_Muhamad%20Rafi%20Fernanda.pdf`;
const codequestPath = `${base}work/codequest/`;
const aksaranetraPath = `${base}work/aksaranetra/`;
const ukmcodingPath = `${base}work/ukm-coding/`;
const andalasiaPath = `${base}work/andalasia/`;
---

{lean ? (
  <footer class="foot foot--lean">
    <div class="foot__inner mono">
      <span>&copy; 2026 Rafi Fernanda</span>
      <span>Jakarta, ID</span>
      <a href={base} data-pt>Back to the index</a>
      <a href="#top">Back to top <img class="arw arw--up" src={`${base}arrow.svg`} alt="" aria-hidden="true" /></a>
    </div>
  </footer>
) : (
  <footer class="foot" data-foot>
    <div class="foot__inner">
      <div class="foot__lead">
        <span class="foot__status mono">Available for freelance projects &amp; internships</span>
        <p class="foot__note">Tell me about your project scope, timeline, or engineering role. I usually respond within a few hours with an honest assessment and next steps.</p>
      </div>
      <div class="foot__cols">
        <div class="foot__col">
          <h3 class="mono">Pages</h3>
          <a href="#work">Selected work</a>
          <a href="#services">Services</a>
          <a href="#experience">Experience</a>
          <a href="#contact">Contact</a>
          <a href={cvPath} download>Curriculum vitae (PDF)</a>
        </div>
        <div class="foot__col">
          <h3 class="mono">Case studies</h3>
          <a href={codequestPath} data-pt>CodeQuest</a>
          <a href={aksaranetraPath} data-pt>AksaraNetra</a>
          <a href={ukmcodingPath} data-pt>UKM Coding</a>
          <a href={andalasiaPath} data-pt>Andalasia Creative</a>
          <a href="https://github.com/randevough" target="_blank" rel="noopener">Source &amp; side projects</a>
        </div>
      </div>
    </div>
    <span class="foot__word" aria-hidden="true">Rafi Fernanda</span>

    <div class="foot__bar mono">
      <span>&copy; 2026 Rafi Fernanda · Jakarta, ID</span>
      <a href="#top">Back to top <img class="arw arw--up" src={`${base}arrow.svg`} alt="" aria-hidden="true" /></a>
    </div>
  </footer>
)}
